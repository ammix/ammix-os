#!/usr/bin/bash
# Package definitions organized by category
# This file is sourced by the build script

# CLI & System Utilities
CLI_PACKAGES=(
    fish
    vim
    sudo-rs
    stow
    just
    luarocks
    zstd
    xz
    flatpak-spawn
    distrobox
    wl-clipboard
    wireguard-tools
    openssl
)

# Hardware & Firmware
# Note: All firmware packages are installed with a generic wildcard in the build script:
#       dnf5 -y --repo=rpmfusion-nonfree-tainted install --skip-broken "*-firmware"
# This ensures all available firmware is installed automatically

# Development & System Tools
DEVELOPMENT_PACKAGES=(
    akmods
    kernel-devel
    kernel-headers
    elfutils-libelf-devel
    bcc
    bpftop
    bpftrace
    nicstat
    numactl
    tiptop
    libgtop2-devel
    sysprof
    lm_sensors
)

# Virtualization & Containers
VIRTUALIZATION_PACKAGES=(
    VirtualBox
    podman
    podman-docker
    podman-compose
    podman-machine
    podman-tui
)

# Media, Graphics & Gaming
MEDIA_PACKAGES=(
    mpv
    ffmpegthumbnailer
    pipewire-plugin-libcamera
    vulkan-tools
    libva-utils
    libavcodec-freeworld
    vvenc-libs
    heif-pixbuf-loader
    libheif
    libheif-freeworld
    gamemode
    scx-scheds
)

# Graphical Applications (Browsers, Terminals, Apps)
GRAPHICAL_APPS=(
    ghostty
    kitty
    vivaldi-stable
    qutebrowser
    Cider
    lact
)

# Desktop Environment & Theming
DESKTOP_PACKAGES=(
    gnome-shell-extension-gsconnect
    nautilus-python
    nautilus-gsconnect
    adw-gtk3-theme
    gvfs-nfs
    firewall-config
    ibus-unikey
    ibus-mozc
)

# Security & Authentication
SECURITY_PACKAGES=(
    pam-u2f
    pamu2fcfg
    pam_yubico
    yubikey-manager
    yubico-piv-tool
    fido2-tools
    pcsc-tools
)

# Storage, Backup & USB Tools
STORAGE_PACKAGES=(
    restic
    rclone
    smartmontools
    usbutils
    usbmuxd
    ifuse
)

# Fonts & Themes
FONT_PACKAGES=(
    bibata-cursor-theme
    google-noto-sans-fonts
    google-noto-serif-fonts
    google-noto-emoji-fonts
    google-noto-sans-cjk-fonts
    google-noto-serif-cjk-fonts
    liberation-fonts
    rsms-inter-fonts
    fira-code-fonts
    nerdfontssymbolsonly-nerd-fonts
    wqy-zenhei-fonts
)

# External RPM URLs
EXTERNAL_RPMS=(
    "https://cdn.filen.io/@filen/desktop/release/latest/Filen_linux_x86_64.rpm"
)

# DNF Group Installs
DNF_GROUPS=(
    "multimedia"
    "virtualization"
    "development-tools"
    "development-libs"
    "c-development"
)

# Packages to Remove
REMOVE_PACKAGES=(
    firefox
    firefox-langpacks
)
