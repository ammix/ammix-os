#!/usr/bin/bash

set -ouex pipefail

# Install dnf5 if not installed
if ! rpm -q dnf5 >/dev/null; then
  rpm-ostree install dnf5 dnf5-plugins
fi

dnf5 -y install rsync

# Copy files
rsync -rvlK /ctx/files/ /

# Make root's home
mkdir -p /var/roothome

sudo dnf5 install @cosmic-desktop-environment \
  --exclude=firefox \
  --exclude=thunderbird \
  --exclude="libreoffice*"
dnf5 -y install xdg-desktop-portal-gtk

# mitigate upstream packaging bug: https://bugzilla.redhat.com/show_bug.cgi?id=2332429
# swap the incorrectly installed OpenCL-ICD-Loader for ocl-icd, the expected package
dnf5 -y swap --repo='fedora' \
  OpenCL-ICD-Loader ocl-icd

# RPM Fusion
echo "Installing RPM Fusion repositories..."
dnf5 -y install \
  https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
  https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm
dnf5 -y config-manager setopt fedora-cisco-openh264.enabled=1
dnf5 -y install rpmfusion-\*-appstream-data
dnf5 -y install rpmfusion-nonfree-release-tainted

# Add Vivaldi repo
echo "Adding Vivaldi repository..."
dnf5 -y config-manager addrepo --from-repofile=https://repo.vivaldi.com/archive/vivaldi-fedora.repo

# Add COPR repos
echo "Enabling COPR repositories..."
dnf5 copr enable -y ilyaz/LACT

# Install Terra
echo "Installing Terra repositories..."
dnf5 -y install --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release
dnf5 -y install terra-release

# Configure repository priorities
echo "Setting repository configurations..."
dnf5 -y config-manager setopt "*rpmfusion*".priority=1

rpm --import https://repo.cider.sh/RPM-GPG-KEY

dnf5 makecache
echo "Successfully configured repositories."

# Firmware
echo "Installing firmware packages..."
dnf5 -y install --repo=rpmfusion-nonfree-tainted "*-firmware"
dnf5 -y install alsa-firmware \
  alsa-tools-firmware \
  amd-gpu-firmware \
  realtek-firmware \
  mediatek-firmware \
  broadcom-bt-firmware \
  gnome-firmware \
  steam-devices

# Swap ffmpeg-free for full ffmpeg from RPM Fusion
echo "Swapping ffmpeg-free for full ffmpeg..."
dnf5 -y --repo=rpmfusion-free swap ffmpeg-free ffmpeg --allowerasing

# Swapping mesa for rpmfusion
dnf5 -y swap mesa-va-drivers mesa-va-drivers-freeworld
dnf5 -y swap mesa-vulkan-drivers mesa-vulkan-drivers-freeworld

# Install multimedia codecs
echo "Installing multimedia codecs..."
dnf5 -y install \
  gstreamer1-plugins-bad-freeworld \
  gstreamer1-plugins-ugly \
  gstreamer1-libav \
  lame\* \
  --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin

# Install fedora-repos-archive
dnf5 install -y fedora-repos-archive

# Source package lists
echo "Loading package lists..."
source /ctx/packages.list

# Install packages by category
echo "Installing CLI & system utilities..."
dnf5 install -y "${CLI_PACKAGES[@]}"

echo "Installing development & system tools..."
dnf5 install -y "${CORE_PACKAGES[@]}"

echo "Installing media, graphics & gaming packages..."
dnf5 install -y "${MEDIA_PACKAGES[@]}"

echo "Installing graphical applications..."
dnf5 install -y "${GRAPHICAL_APPS[@]}"

echo "Installing fonts & themes..."
dnf5 install -y "${FONT_PACKAGES[@]}"

# Install external RPMs
echo "Installing external RPMs..."
for rpm_url in "${EXTERNAL_RPMS[@]}"; do
  echo "Installing from: ${rpm_url}"
  dnf5 install -y "${rpm_url}"
done

# Install group packages
echo "Installing package groups..."
for group in "${DNF_GROUPS[@]}"; do
  echo "Installing group: ${group}"
  dnf5 group install -y --skip-unavailable "${group}"
done

# Install additional tools
echo "Installing cosign..."
/ctx/github-release-install sigstore/cosign x86_64

# Remove unwanted packages
echo "Removing unwanted packages..."
dnf5 remove -y "${REMOVE_PACKAGES[@]}"

# Clean up
dnf5 clean packages

# Install fonts (custom script)
echo "Installing custom fonts..."
/ctx/fonts

# Enable systemd services
echo "Enabling systemd services..."
systemctl enable cosmic-greeter.service
systemctl enable scx_loader.service
systemctl enable lactd.service
systemctl enable libvirtd.service
systemctl enable ammix-bootc-update.timer
systemctl enable flatpak-update.timer
systemctl enable podman.socket

# Mask unwanted services
echo "Masking systemd services..."
systemctl mask grub-boot-success.timer
systemctl mask systemd-remount-fs.service
systemctl mask akmods-keygen@akmods-keygen.service
systemctl mask rpm-ostreed-automatic.service
systemctl mask rpm-ostreed-automatic.timer

# Make sure /var/tmp is properly created
mkdir -p /var/tmp
chmod -R 1777 /var/tmp

# Plymouth theme
echo "Setting Plymouth theme..."
plymouth-set-default-theme catppuccin-mocha
