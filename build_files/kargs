#!/usr/bin/bash

set -euo pipefail

echo "Setting up kernel arguments..."

# Directory for bootc kargs
KARGS_D="/usr/lib/bootc/kargs.d"
KARGS_TOML="${KARGS_D}/ammix-kargs.toml"

# Create kargs.d directory
mkdir -p "${KARGS_D}"

# Define kernel arguments
KARGS=(
    "quiet"
    "splash"
    "udev.log_priority=3"
    "vconsole.keymap=de-us"
    "amdgpu.ppfeaturemask=0xfffd7fff"
    "amdgpu.gfxoff=0"
)

# Format kargs for TOML
formatted_kargs=$(printf '"%s", ' "${KARGS[@]}")
formatted_kargs=${formatted_kargs%, }

# Write kargs to TOML file
echo "Writing kernel arguments to ${KARGS_TOML}"
echo "kargs = [${formatted_kargs}]" > "${KARGS_TOML}"

echo "Successfully configured kernel arguments: ${KARGS[*]}"
