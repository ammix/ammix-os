#!/usr/bin/env bash
set -euo pipefail

GNOME_EXTENSIONS=(
  "Blur my Shell"
  "Fullscreen Avoider"
  "RunCat"
)
# -----------------------------------------------

# Basic checks
for cmd in gnome-shell curl jq unzip; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "ERROR: Required command '$cmd' not found"
    exit 1
  fi
done

if ! command -v gnome-shell >/dev/null 2>&1; then
  echo "ERROR: gnome-shell not found; this script targets GNOME images"
  exit 1
fi

GNOME_VER=$(gnome-shell --version | sed 's/[^0-9]*\([0-9]*\).*/\1/')
echo "Detected GNOME version: ${GNOME_VER}"

if [[ ${#GNOME_EXTENSIONS[@]} -lt 1 ]]; then
  echo "Nothing to install: GNOME_EXTENSIONS is empty"
  exit 0
fi

for EXT in "${GNOME_EXTENSIONS[@]}"; do
  echo "Installing extension: ${EXT}"

  # Simple URL encoding for spaces (sufficient for common extension names)
  QNAME="${EXT// /%20}"
  QUERY_JSON=$(curl -sf "https://extensions.gnome.org/extension-query/?search=${QNAME}") || {
    echo "ERROR: Failed to query extensions.gnome.org for '${EXT}'"
    exit 1
  }

  # Count exact-name matches
  MATCHES=$(echo "$QUERY_JSON" | jq "[.extensions[] | select(.name == \"${EXT}\")] | length")
  if [[ "$MATCHES" -eq 0 ]]; then
    echo "ERROR: Extension '${EXT}' not found on extensions.gnome.org"
    exit 1
  elif [[ "$MATCHES" -gt 1 ]]; then
    echo "ERROR: Multiple extensions named '${EXT}' found; please use a more specific name or modify script"
    exit 1
  fi

  EXT_UUID=$(echo "$QUERY_JSON" | jq -r ".extensions[] | select(.name == \"${EXT}\") | .uuid")
  SUITABLE_VERSION=$(echo "$QUERY_JSON" | jq -r ".extensions[] | select(.name == \"${EXT}\") | .shell_version_map[\"${GNOME_VER}\"].version")

  if [[ -z "$SUITABLE_VERSION" || "$SUITABLE_VERSION" == "null" ]]; then
    echo "ERROR: '${EXT}' has no compatible release for GNOME ${GNOME_VER}"
    exit 1
  fi

  ZIP_URL="https://extensions.gnome.org/extension-data/${EXT_UUID//@/}.v${SUITABLE_VERSION}.shell-extension.zip"
  TMP_DIR="/tmp/gnome-ext-${EXT_UUID}"
  mkdir -p "$TMP_DIR"
  ARCHIVE="$TMP_DIR/$(basename "$ZIP_URL")"

  echo "  Download: $ZIP_URL"
  curl -fLs "$ZIP_URL" -o "$ARCHIVE" || { echo "ERROR: Failed to download $ZIP_URL"; exit 1; }

  echo "  Unpacking..."
  unzip -q "$ARCHIVE" -d "$TMP_DIR"
  rm -f "$ARCHIVE"

  TARGET_DIR="/usr/share/gnome-shell/extensions/${EXT_UUID}"
  echo "  Installing files to ${TARGET_DIR}"
  install -d -m 0755 "$TARGET_DIR"
  # Copy everything except schemas/ and locale/
  find "$TMP_DIR" -mindepth 1 -maxdepth 1 ! -path "$TMP_DIR/schemas" ! -path "$TMP_DIR/locale" -exec cp -r {} "$TARGET_DIR/" \;

  # Fix permissions
  find "$TARGET_DIR" -type d -exec chmod 0755 {} +
  find "$TARGET_DIR" -type f -exec chmod 0644 {} +

  # Install schemas if present
  if [[ -d "$TMP_DIR/schemas" ]]; then
    echo "  Installing extension schemas to /usr/share/glib-2.0/schemas/"
    install -d -m 0755 /usr/share/glib-2.0/schemas/
    install -m 0644 "$TMP_DIR"/schemas/*.gschema.xml /usr/share/glib-2.0/schemas/ || true
    if command -v glib-compile-schemas >/dev/null 2>&1; then
      glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 || true
    fi
  fi

  # Install locale files if present
  if [[ -d "$TMP_DIR/locale" ]]; then
    echo "  Installing locale files to /usr/share/locale/"
    install -d -m 0755 /usr/share/locale/
    cp -r "$TMP_DIR"/locale/* /usr/share/locale/ || true
  fi

  # Cleanup
  rm -rf "$TMP_DIR"

  echo "  '${EXT}' installed."
done

echo "All done."
